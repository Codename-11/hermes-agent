{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nousresearch.com/hermes-agent/fork-carries.schema.json",
  "title": "Hermes fork carry manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "carries"],
  "properties": {
    "schema_version": {"const": 1, "type": "integer"},
    "carries": {
      "type": "array",
      "items": {"$ref": "#/$defs/carry"}
    }
  },
  "$defs": {
    "kebab": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonblank": {
      "type": "string",
      "pattern": "\\S"
    },
    "repoPath": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[*?\\[\\]{}])[^/]+(?:/[^/]+)*$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "heading"],
      "properties": {
        "path": {"$ref": "#/$defs/repoPath"},
        "heading": {"$ref": "#/$defs/nonblank"}
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "revision"],
      "properties": {
        "kind": {"const": "commit"},
        "repository": {"$ref": "#/$defs/nonblank"},
        "revision": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "number"],
      "properties": {
        "kind": {"const": "pull_request"},
        "repository": {"$ref": "#/$defs/nonblank"},
        "number": {"type": "integer", "minimum": 1}
      }
    },
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description"],
      "properties": {
        "kind": {"const": "manual"},
        "description": {"$ref": "#/$defs/nonblank"}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cwd", "argv", "env", "covers"],
      "properties": {
        "id": {"$ref": "#/$defs/kebab"},
        "cwd": {
          "anyOf": [
            {"const": "."},
            {"$ref": "#/$defs/repoPath"}
          ]
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "pattern": "\\S"}
        },
        "env": {
          "type": "object",
          "propertyNames": {"minLength": 1},
          "additionalProperties": {"type": "string"}
        },
        "covers": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repoPath"}
        }
      }
    },
    "carry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "title",
        "status",
        "domain_id",
        "ownership",
        "contract",
        "depends_on",
        "provenance",
        "summary",
        "paths",
        "tests",
        "checks",
        "retirement"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/kebab"},
        "order": {"type": "integer", "minimum": 1},
        "title": {"$ref": "#/$defs/nonblank"},
        "status": {"enum": ["active", "retired"]},
        "domain_id": {"$ref": "#/$defs/kebab"},
        "ownership": {"enum": ["core", "plugin", "mixed"]},
        "contract": {"$ref": "#/$defs/contract"},
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/kebab"}
        },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/commit"},
              {"$ref": "#/$defs/pull_request"},
              {"$ref": "#/$defs/manual"}
            ]
          }
        },
        "summary": {"$ref": "#/$defs/nonblank"},
        "paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repoPath"}
        },
        "tests": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repoPath"}
        },
        "checks": {
          "type": "array",
          "items": {"$ref": "#/$defs/check"}
        },
        "retirement": {"$ref": "#/$defs/nonblank"},
        "references": {"type": "array", "items": {"type": "string"}},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "active"}}, "required": ["status"]},
          "then": {
            "properties": {
              "paths": {"minItems": 1},
              "tests": {"minItems": 1},
              "checks": {"minItems": 1}
            }
          }
        }
      ]
    }
  }
}
